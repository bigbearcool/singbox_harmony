{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:module_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:window_background",
        "exported": true,
        "launchType": "singleton",
        "metadata": [{"name":"ohos.ability.shortcuts","resource":"$profile:shortcuts_config"}],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "entities": [
              "entity.system.browsable"
            ],
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "sing-box",
                "host": "import-remote-profile"
              }
            ]
          }
        ],
        "backgroundModes": [
          "dataTransfer",
          "location"
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name":"QuickEntryFormAbility",
        "srcEntry":"./ets/quickentry/QuickEntryFormAbility.ets",
        "label":"$string:quick_entry_name",
        "description":"$string:quick_entry_description",
        "type":"form",
        "exported":true,
        "metadata":[{"name":"ohos.extension.form","resource":"$profile:form_config"}]
      },
      {
        "name": "SingboxVpnAbility",
        "srcEntry": "./ets/vpn/SingboxVpnAbility.ets",
        "type": "vpn",
        "exported": false
      },
      {
        "name": "SubscriptionWorkAbility",
        "srcEntry": "./ets/work/SubscriptionWorkAbility.ets",
        "type": "workScheduler",
        "exported": false
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:location_assist_reason",
        "usedScene": {
          "abilities": [
            "EntryAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
